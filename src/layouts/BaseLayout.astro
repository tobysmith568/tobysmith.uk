---
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import spaceGroteskWoff2 from "@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url";
import "@fontsource/public-sans/400.css";
import "@fontsource/public-sans/400-italic.css";
import "@fontsource-variable/fira-code";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/BaseLayout/Header.astro";
import Footer from "../components/BaseLayout/Footer.astro";

interface Props {
  title: string | undefined;
  description: string | undefined;
  noIndex?: boolean;
}

const props = ((Astro.props as any).frontmatter || Astro.props) as Props;
const { description, noIndex } = props;

const defaultTitle = "Toby Smith";
const pageTitle = props.title;
const title =
  pageTitle && pageTitle !== defaultTitle ? `${pageTitle} - ${defaultTitle}` : defaultTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href={spaceGroteskWoff2} crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
  </head>

  <body>
    <Header />

    <main>
      <div class="wrap content">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .content {
    padding-block: clamp(2rem, 6vw, 3.5rem) var(--sp-9);
  }
</style>
