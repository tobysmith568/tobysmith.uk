---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import Icon from "../../components/Icon.astro";
import { resolveProjectImage } from "../../components/Projects/resolveProjectImage";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map(entry => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { title, tagLine } = entry.data;

const projectImgSrcPromise = resolveProjectImage(entry.id);
---

<BaseLayout title={title} description={tagLine}>
  <div class="doc">
    <div class="doc-rail">
      <a href="/projects" class="back more mono">
        <Icon name="arrow-left" size={14} />
        My Projects
      </a>
    </div>

    <article>
      <div class="details">
        {projectImgSrcPromise && <Image src={projectImgSrcPromise} alt="" />}
        <h1>{entry.data.title}</h1>
        <p class="tagline">{tagLine}</p>
      </div>

      <Prose>
        <Content />
      </Prose>
    </article>
  </div>
</BaseLayout>

<style>
  .back:hover :global(svg),
  .back:focus-visible :global(svg) {
    transform: translateX(-2px);
  }

  .details {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: var(--sp-8);
    padding-bottom: var(--sp-7);
    border-bottom: 1px solid var(--border);

    img {
      max-width: min(10rem, 40vw);
      height: auto;
      margin-bottom: var(--sp-4);
    }

    h1 {
      font-size: var(--text-3xl);
    }

    .tagline {
      margin-top: var(--sp-3);
      color: var(--muted);
    }
  }
</style>
