---
import Hero from "../components/Index/Hero.astro";
import About from "../components/Index/About.astro";
import ProjectsSpotlight from "../components/Index/ProjectsSpotlight.astro";
import BlogSpotlight from "../components/Index/BlogSpotlight.astro";
import ContactSection from "../components/Index/ContactSection.astro";
import Layout from "../layouts/BaseLayout.astro";

const title = "Toby Smith";
const description =
  "Toby Smith is a London-based software developer who enjoys focusing on web-based technologies.";
---

<Layout title={title} description={description}>
  <Hero />
  <About />
  <ProjectsSpotlight />
  <BlogSpotlight />
  <ContactSection />
</Layout>
