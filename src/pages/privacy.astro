---
import { getCollection, render } from "astro:content";
import PolicyLayout from "../layouts/PolicyLayout.astro";
import Icon from "../components/Icon.astro";
import dayjs from "dayjs";

const title = "Privacy Policy";
const description = "The privacy policy for tobysmith.uk";

const policies = await getCollection("policies");
const termPolicy = policies.find(p => p.id === "privacy");

if (!termPolicy) {
  throw new Error("Cannot find the privacy policy");
}

const { Content } = await render(termPolicy);

const humanReadableDate = dayjs(termPolicy.data.lastUpdated).format("DD MMM YYYY");
const parseableDate = dayjs(termPolicy.data.lastUpdated).format("YYYY-MM-DD");
---

<PolicyLayout title={title} description={description} noIndex>
  <Fragment slot="rail">
    <a href="/" class="back more mono">
      <Icon name="arrow-left" size={14} />
      Home
    </a>
    <time class="mono" datetime={parseableDate}>{humanReadableDate}</time>
  </Fragment>

  <Content />
</PolicyLayout>
