---

---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    h2,
    h3,
    h4 {
      margin-top: var(--sp-6);
      margin-bottom: var(--sp-3);
    }

    h3 {
      font-size: var(--text-lg);
      font-weight: 500;
    }

    p,
    ul,
    ol,
    blockquote {
      max-width: var(--measure);
    }

    a {
      color: var(--ink);
      text-decoration-line: underline;
      text-decoration-color: var(--underline);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.15em;
      transition:
        text-decoration-color var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out);
    }
    a:hover,
    a:focus-visible {
      color: var(--accent);
      text-decoration-color: var(--accent);
      text-decoration-thickness: 2px;
    }

    code {
      font-size: 0.9em;
    }

    :not(pre) > code {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.1em 0.4em;
    }

    /* The fill + syntax colours come from Shiki (inline on light; global.css swaps to the
       --shiki-dark* values when the dark palette is active). Only the frame is ours. */
    pre:has(code) {
      margin: var(--sp-4) 0;
      padding: var(--sp-4) var(--sp-5);
      border: 1px solid var(--border);
      border-left: 2px solid var(--border);
      border-radius: var(--radius);
      transition: border-left-color var(--dur-base) var(--ease-out);

      &:hover {
        border-left-color: var(--accent);
      }
    }

    blockquote {
      margin: var(--sp-4) 0;
      padding: var(--sp-4) var(--sp-5);
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 2px solid var(--accent);
      border-radius: var(--radius);

      p {
        margin: 0;
      }
    }
  }
</style>
