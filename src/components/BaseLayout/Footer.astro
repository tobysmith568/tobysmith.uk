---
import Anchor from "../Anchor.astro";
const year = new Date().getUTCFullYear();
---

<footer>
  <div class="wrap bar mono">
    <span>© Toby Smith {year}</span>

    <nav class="links" aria-label="Legal">
      <Anchor href="/terms" text="terms" data-astro-prefetch="false" />
      <Anchor href="/privacy" text="privacy" data-astro-prefetch="false" />
      <Anchor href="/cookies" text="cookies" data-astro-prefetch="false" />
      <Anchor href="/third-party" text="licenses" data-astro-prefetch="false" />
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    padding-block: var(--sp-5) var(--sp-7);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--text-xs);
  }

  .links {
    display: flex;
    gap: var(--sp-4);
  }

  .links :global(a) {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--underline);
    text-underline-offset: 0.15em;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .links :global(a:hover),
  .links :global(a:focus-visible) {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
