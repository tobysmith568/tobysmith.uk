---

---

<div
  class="shadow"
  x-show="mobileMenuOpen"
  x-cloak
  x-transition.opacity
  @click.self="mobileMenuOpen = false">
  <div class="mobile-nav" @click="mobileMenuOpen = false">
    <a href="/projects">Projects</a>
    <a href="/blog">Blog</a>
    <a href="/#contact">Contact</a>
  </div>
</div>

<style>
  .shadow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;

    background-color: rgba(0, 0, 0, 0.6);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    position: absolute;
    height: 100vh;
    width: 40vw;
    min-width: 350px;
    right: 0;

    background-color: var(--primary);
    color: var(--primary-text);

    a:first-of-type {
      margin-top: 5em;
    }
  }

  a {
    color: inherit;
    padding: 1em 2em;
    text-decoration: none;
  }
</style>
