---
// The frontmatter block is this direction's signature element - see redesign.md's Design
// direction section. `role` cycles once through the old rotating job-title joke on load, then
// settles on the real title; a visually-hidden span carries the real title throughout so screen
// readers never see the animation. Everything here respects prefers-reduced-motion (see script).
---

<section class="hero">
  <div class="identity">
    <img
      class="avatar"
      src="https://github.com/tobysmith568.png?width=320"
      alt=""
      width="96"
      height="120"
    />

    <dl class="frontmatter mono">
      <div class="row"><dt>name</dt><dd>Toby Smith</dd></div>
      <div class="row">
        <dt>role</dt>
        <dd class="role">
          <span class="role-sizer" aria-hidden="true">Senior Software Developer</span>
          <span id="role-cycle" aria-hidden="true">Full-stack developer</span>
          <span class="sr-only">Senior Software Developer</span>
        </dd>
      </div>
      <div class="row"><dt>location</dt><dd>London, UK</dd></div>
      <div class="row">
        <dt>links</dt>
        <dd class="links">
          <a href="https://github.com/tobysmith568" target="_blank" rel="noopener noreferrer"
            >github</a
          >
          <a href="https://linkedin.com/in/tobysmith568" target="_blank" rel="noopener noreferrer"
            >linkedin</a
          >
          <a href="/blog/rss.xml" target="_blank" rel="noopener noreferrer">rss</a>
        </dd>
      </div>
    </dl>
  </div>

  <h1 class="lead">Builds small developer tools and writes about the <em>sharp edges</em>.</h1>
</section>

<style>
  .hero {
    padding-block: var(--sp-2) var(--sp-5);
  }

  .identity {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-5);
    margin-bottom: var(--sp-6);
  }

  .avatar {
    width: 6rem;
    height: 7.5rem; /* 4:5 portrait crop of the square source - reads as an ID photo */
    border-radius: var(--radius);
    border: 1px solid var(--border);
    object-fit: cover;
    object-position: center 25%;
    flex-shrink: 0;
  }

  .frontmatter {
    display: grid;
    gap: var(--sp-2);
    margin: 0; /* reset the <dl> default so it aligns to the avatar's top edge */
    color: var(--muted);
    border-left: 2px solid var(--border);
    padding-left: var(--sp-4);
  }

  .row {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--sp-3);
    font-size: var(--text-sm);

    opacity: 0;
    transform: translateY(6px);
    animation: settle var(--dur-slow) var(--ease-standard) forwards;
  }

  /* While the page is being prerendered in the background (clientPrerender), freeze the load-in
     so it hasn't already finished by the time the page is actually shown - the script removes
     this on activation. See the script below. */
  .hero.defer .row,
  .hero.defer .lead {
    animation: none;
  }
  .row:nth-child(1) {
    animation-delay: 40ms;
  }
  .row:nth-child(2) {
    animation-delay: 100ms;
  }
  .row:nth-child(3) {
    animation-delay: 160ms;
  }
  .row:nth-child(4) {
    animation-delay: 220ms;
  }

  @keyframes settle {
    to {
      opacity: 1;
      transform: none;
    }
  }

  dt {
    color: color-mix(in srgb, var(--muted) 75%, var(--ink));
  }
  dd {
    margin: 0;
    color: var(--ink);
  }

  /* The role value reserves the width of its longest string (an invisible sizer copy stacked
     under the animated span) so swapping the visible text never changes the record's width.
     Without this, a shorter quip shrinks the block out from under the cursor on hover, which
     fires mouseleave -> restores the long title -> re-hovers -> loops forever near the edge. */
  .role {
    display: grid;
    justify-items: start;
  }
  .role > :not(.sr-only) {
    grid-area: 1 / 1;
  }
  .role-sizer {
    visibility: hidden;
  }

  #role-cycle {
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  #role-cycle.swap {
    opacity: 0;
    transform: translateY(-3px);
  }

  .links {
    display: flex;
    gap: var(--sp-4);
  }
  .links a {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-color: var(--underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition:
      text-decoration-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--accent);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  .lead {
    font-size: clamp(2rem, 5.5vw, var(--text-4xl));
    line-height: 1.12;
    letter-spacing: -0.03em;
    max-width: 22ch;

    opacity: 0;
    transform: translateY(8px);
    animation: settle var(--dur-slow) var(--ease-standard) 0.34s forwards;
  }

  .lead em {
    font-style: normal;
  }

  @media (max-width: 480px) {
    .identity {
      flex-direction: column;
      gap: var(--sp-4);
    }
    .row {
      grid-template-columns: 4rem 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row,
    .lead {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  // The old design cycled the job title forever, every 3s - this direction's motion tokens
  // deliberately rule out that kind of persistent ambient motion (see redesign.md's Design
  // tokens > Motion). Instead the whole load-in - the frontmatter rows settling, the lead line,
  // and this one-shot role cycle - plays once, together, and lands on the real title. Once
  // that's done, hovering the frontmatter block flicks the role to a random quip and it snaps
  // back to the real title on leave - the joke stays reachable, but only when the reader asks
  // for it (see redesign.md's Design tokens > Motion, and the Decision log).
  const quips = [
    "Full-stack developer",
    "npm package author",
    "TypeScript fanatic",
    "Burrito over-filler"
  ];
  const finalTitle = "Senior Software Developer";
  const sequence = [...quips, finalTitle];

  const hero = document.querySelector<HTMLElement>(".hero");
  const frontmatter = hero?.querySelector(".frontmatter");
  const roleEl = document.getElementById("role-cycle");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let swapTimer: number | undefined;
  const setRole = (text: string) => {
    if (!roleEl) return;
    window.clearTimeout(swapTimer);
    roleEl.classList.add("swap");
    swapTimer = window.setTimeout(() => {
      roleEl.textContent = text;
      roleEl.classList.remove("swap");
    }, 140);
  };

  const cycleRole = (onDone: () => void) => {
    if (!roleEl) {
      onDone();
      return;
    }

    let i = 0;
    const step = () => {
      roleEl.classList.add("swap");

      window.setTimeout(() => {
        i++;
        roleEl.textContent = sequence[i] ?? finalTitle;
        roleEl.classList.remove("swap");

        if (i < sequence.length - 1) {
          window.setTimeout(step, 480);
        } else {
          onDone();
        }
      }, 140);
    };

    window.setTimeout(step, 900);
  };

  // Hover easter egg: armed only once the load-in has settled, mouse-only (no touch, no
  // keyboard path - the `.sr-only` span keeps the real title for assistive tech throughout).
  const armHover = () => {
    if (!frontmatter || !roleEl || !window.matchMedia("(hover: hover)").matches) return;

    let lastQuip = "";
    const randomQuip = () => {
      const pool = quips.filter(quip => quip !== lastQuip);
      const next = pool[Math.floor(Math.random() * pool.length)] ?? finalTitle;
      lastQuip = next;
      return next;
    };

    frontmatter.addEventListener("mouseenter", () => setRole(randomQuip()));
    frontmatter.addEventListener("mouseleave", () => setRole(finalTitle));
  };

  const playLoadIn = () => {
    if (hero) {
      hero.classList.remove("defer");
      void hero.offsetWidth; // restart the row/lead settle animations from their first frame
    }

    if (prefersReducedMotion) {
      if (roleEl) roleEl.textContent = finalTitle;
      armHover();
      return;
    }

    cycleRole(armHover);
  };

  // With `clientPrerender`, navigating here from another page activates a document that was
  // already prerendered in the background - its CSS animations would have run to completion and
  // this timer partway through, all before the page was ever visible. Hold the load-in until
  // activation so it plays for real. `document.prerendering` is undefined outside Chrome's
  // speculation-rules prerender, so this is a plain no-op on a normal page load.
  const doc = document as Document & { prerendering?: boolean };
  if (doc.prerendering) {
    hero?.classList.add("defer");
    doc.addEventListener("prerenderingchange", playLoadIn, { once: true });
  } else {
    playLoadIn();
  }
</script>
