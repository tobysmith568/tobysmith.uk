---
import { getCollection } from "astro:content";
import BlogListItem from "../Blog/BlogListItem.astro";

// Placeholder count - the final number is a layout call deferred to the visual redesign, see
// migration.md's "Open items".
const SPOTLIGHT_COUNT = 2;

const blogPosts = await getCollection("blog");
const spotlightPosts = blogPosts
  .sort((a, b) => a.data.sortWeight - b.data.sortWeight)
  .reverse()
  .slice(0, SPOTLIGHT_COUNT);
---

<section id="blog">
  <h2>Blog</h2>

  {spotlightPosts.map(post => <BlogListItem post={post} />)}

  <a class="more" href="/blog">More posts →</a>
</section>

<style>
  section {
    margin-top: 3rem;
  }

  .more {
    display: inline-block;
    margin-top: 1rem;
    font-weight: bold;
  }
</style>
