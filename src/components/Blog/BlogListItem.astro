---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import Icon from "../Icon.astro";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data } = post;
const { slug, title, description, date } = data;

const humanReadableDate = dayjs(date).format("DD MMM YYYY");
const parseableDate = dayjs(date).format("YYYY-MM-DD");
---

<article class="item">
  <a href={"/blog/" + slug}>
    <div class="body">
      <time class="mono" datetime={parseableDate}>{humanReadableDate}</time>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <Icon name="arrow-right" size={16} />
  </a>
</article>

<style>
  .item {
    border-bottom: 1px solid var(--border);
  }
  .item:first-of-type {
    border-top: 1px solid var(--border);
  }

  a {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    text-decoration: none;
    color: inherit;
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  a > :global(svg) {
    flex-shrink: 0;
    margin-top: 0.35em;
    color: var(--muted);
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  a:hover > :global(svg),
  a:focus-visible > :global(svg) {
    transform: translateX(3px);
    color: var(--accent);
  }

  time {
    display: block;
    margin-bottom: var(--sp-1);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }

  a:hover h2,
  a:focus-visible h2 {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  p {
    margin: var(--sp-2) 0 0;
    color: var(--muted);
    max-width: 58ch;
  }
</style>
