---
// Small geometric line-icon set - see redesign.md's "Other primitives". Icons inherit
// `currentColor` and a 1.5px stroke so they sit with the mono UI chrome; size via the `size`
// prop (px) or CSS `width`/`height` on the element.
interface Props {
  name:
    | "arrow-right"
    | "arrow-left"
    | "arrow-up-right"
    | "rss"
    | "close"
    | "menu"
    | "sun"
    | "moon"
    | "monitor";
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

const paths: Record<Props["name"], string> = {
  "arrow-right": '<path d="M3 8h10M9 4l4 4-4 4"/>',
  "arrow-left": '<path d="M13 8H3M7 4L3 8l4 4"/>',
  "arrow-up-right": '<path d="M5 11 11 5M6 5h5v5"/>',
  rss: '<path d="M3 3c5.523 0 10 4.477 10 10M3 8a5 5 0 0 1 5 5"/><circle cx="3.5" cy="12.5" r="1.1" fill="currentColor" stroke="none"/>',
  close: '<path d="M4 4l8 8M12 4l-8 8"/>',
  menu: '<path d="M2 4h12M2 8h12M2 12h12"/>',
  sun: '<circle cx="8" cy="8" r="3"/><path d="M8 1.5V3M8 13v1.5M14.5 8H13M3 8H1.5M12.6 3.4l-1.05 1.05M4.45 11.55 3.4 12.6M12.6 12.6l-1.05-1.05M4.45 4.45 3.4 3.4"/>',
  moon: '<path d="M8 2a4 4 0 0 0 6 6 6 6 0 1 1-6-6Z"/>',
  monitor: '<rect x="1.5" y="2" width="13" height="9.5" rx="1.5"/><path d="M5.5 14h5M8 11.5v2.5"/>'
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
