---
import Anchor from "../Anchor.astro";
import Icon from "../Icon.astro";
---

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback&render=explicit"
  async
  defer></script>

<form id="contact-form">
  <div class="fields" x-data="{ name: '', email: '', message: '' }">
    <div class="field">
      <label class="mono" for="name">name</label>
      <input id="name" x-model="name" type="text" minlength="1" name="name" autocomplete="name" />
    </div>

    <div class="field">
      <label class="mono" for="email">email</label>
      <input id="email" x-model="email" type="email" name="email" autocomplete="email" />
    </div>

    <div class="field field--full">
      <label class="mono" for="message">message</label>
      <textarea id="message" x-model="message" name="message" minlength="1" rows="6"></textarea>
    </div>

    <button type="submit" class="mono" disabled x-bind:disabled="!isValid(name, email, message)">
      send message
      <Icon name="arrow-right" size={14} />
    </button>

    <p id="result-message" class="hidden mono"></p>

    <p class="turnstile-terms">
      This site is protected by Cloudflare Turnstile and the Cloudflare
      {" "}
      <Anchor href="https://www.cloudflare.com/privacypolicy/" text="Privacy Policy" />
      {" "}
      and
      {" "}
      <Anchor href="https://www.cloudflare.com/website-terms/" text="Terms of Service" />
      {" "}
      apply.
    </p>
  </div>
</form>

<div id="turnstile-widget" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>

<script is:inline>
  // Only referenced from the `x-bind:disabled` directive string on the submit button above -
  // invisible to static analysis, so ESLint sees this as unused.
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  function isValid(name, email, message) {
    return name && email && message;
  }
</script>

<style>
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4) var(--sp-4);
    max-width: var(--measure);

    @media (max-width: 34rem) {
      grid-template-columns: 1fr;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
    }

    .field--full,
    #result-message,
    button[type="submit"],
    .turnstile-terms {
      grid-column: 1 / -1;
    }

    label {
      font-size: var(--text-xs);
      color: var(--muted);
    }

    input,
    textarea {
      font: inherit;
      font-size: var(--text-base);
      padding: var(--sp-2) var(--sp-3);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      color: var(--ink);
      transition: border-color var(--dur-fast) var(--ease-out);
    }

    input:hover,
    textarea:hover {
      border-color: var(--muted);
    }

    input:focus-visible,
    textarea:focus-visible {
      border-color: transparent;
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    textarea {
      resize: vertical;
    }

    button[type="submit"] {
      justify-self: start;
      display: inline-flex;
      align-items: center;
      gap: 0.6ch;
      margin-top: var(--sp-3);
      font-size: var(--text-sm);
      padding: var(--sp-3) var(--sp-5);
      background: var(--ink);
      color: var(--surface);
      border: 0;
      border-radius: var(--radius);
      cursor: pointer;
      transition: background var(--dur-fast) var(--ease-out);

      &:hover:not(:disabled) {
        background: var(--accent-strong);
      }

      &:disabled {
        background: var(--border);
        color: var(--muted);
        cursor: not-allowed;
      }

      &:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
    }

    .turnstile-terms {
      margin-top: var(--sp-4);
      font-size: var(--text-xs);
      color: var(--muted);
    }
  }

  /* Turnstile's rendered widget has a fixed ~300px minimum width - keep it from pushing the
     page sideways on very narrow viewports by letting the container scroll instead. */
  #turnstile-widget {
    max-width: 100%;
    overflow-x: auto;
  }

  #result-message {
    margin-top: var(--sp-2);
    padding-left: var(--sp-3);
    border-left: 2px solid var(--accent);
    font-size: var(--text-sm);
  }

  #result-message.err {
    color: var(--error);
    border-left-color: var(--error);
  }

  .hidden {
    display: none;
  }
</style>

<script>
  import { parseFormData } from "../../scripts/contact/parseFormData";
  import { sendContactEmail } from "../../scripts/contact/sendContactEmail";

  interface TurnstileRenderOptions {
    sitekey: string;
    callback: (token: string) => void;
    execution?: "render" | "execute";
  }

  declare global {
    interface Window {
      onloadTurnstileCallback: () => void;
    }

    var turnstile: {
      render: (container: string | HTMLElement, options: TurnstileRenderOptions) => string;
      execute: (container: string | HTMLElement) => void;
    };
  }

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const resultMessage = document.getElementById("result-message");
  const turnstileWidget = document.getElementById("turnstile-widget");

  let formData: FormData | null = null;

  form?.addEventListener("submit", function onSubmit(event) {
    event.preventDefault();

    formData = new FormData(event.target as HTMLFormElement);

    const inputs = form.querySelectorAll("input, textarea");
    for (const input of inputs) {
      input.setAttribute("disabled", "true");
    }

    const submitButton = form.querySelector("button[type='submit']");
    if (submitButton) {
      submitButton.setAttribute("disabled", "true");
    }

    turnstile.execute("#turnstile-widget");
  });

  async function onGetTurnstileToken(token: string) {
    if (!formData) return;

    try {
      const validatedFormData = parseFormData(formData);
      await sendContactEmail(validatedFormData, token);

      if (resultMessage) {
        resultMessage.textContent = "Message sent successfully!";
        resultMessage.classList.remove("hidden", "err");
      }
    } catch (error) {
      console.error(error);

      const errorMessage =
        error instanceof Error ? error.message : (error?.toString() ?? "Unknown error");

      if (resultMessage) {
        resultMessage.textContent = errorMessage;
        resultMessage.classList.remove("hidden");
        resultMessage.classList.add("err");
      }
    }
  }

  window.onloadTurnstileCallback = function onloadTurnstileCallback() {
    const sitekey = turnstileWidget?.dataset.sitekey;
    if (!turnstileWidget || !sitekey) return;

    turnstile.render(turnstileWidget, {
      sitekey,
      callback: onGetTurnstileToken,
      execution: "execute"
    });
  };
</script>
