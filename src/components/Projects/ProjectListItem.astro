---
import type { CollectionEntry } from "astro:content";
import Icon from "../Icon.astro";

export interface Props {
  project: CollectionEntry<"projects">;
  // Tags are shown on the /projects listing only, not the index spotlight (which stays lean).
  showTags?: boolean;
}

const { project, showTags = false } = Astro.props;
const { id: slug, data } = project;
const { title, tagLine, tags } = data;
const path = "/projects/" + slug;
---

<article class="item">
  <a href={path}>
    <div class="body">
      <h2>{title}</h2>
      <p>{tagLine}</p>
      <span class="path mono">{path}</span>
      {
        showTags && tags && tags.length > 0 && (
          <ul class="tags">
            {tags.map(tag => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
    <Icon name="arrow-right" size={16} />
  </a>
</article>

<style>
  .item {
    border-bottom: 1px solid var(--border);
  }
  .item:first-of-type {
    border-top: 1px solid var(--border);
  }

  a {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    text-decoration: none;
    color: inherit;
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  a > :global(svg) {
    flex-shrink: 0;
    margin-top: 0.35em;
    color: var(--muted);
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  a:hover > :global(svg),
  a:focus-visible > :global(svg) {
    transform: translateX(3px);
    color: var(--accent);
  }

  h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }

  a:hover h2,
  a:focus-visible h2 {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  p {
    margin: var(--sp-1) 0 0;
    color: var(--muted);
    max-width: 58ch;
  }

  .path {
    display: block;
    margin-top: var(--sp-2);
    font-size: var(--text-xs);
    color: var(--muted);
  }

  /* chip styling comes from the shared .tags utility in global.css; only the offset from
     the route path above it is list-item specific */
  .tags {
    margin-top: var(--sp-3);
  }
</style>
