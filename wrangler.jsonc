{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "tobysmith-uk",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "send_email": [{ "name": "SEB" }],
  "vars": {
    // Not sensitive - a public Google endpoint, safe to commit. The actual secret is
    // RECAPTCHA_SECRET_KEY, set via `wrangler secret put` (never in this file).
    "RECAPTCHA_ENDPOINT": "https://www.google.com/recaptcha/api/siteverify"
  },
  "observability": {
    "enabled": true
  }
}
